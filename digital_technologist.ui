  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background: #e6e6e6;
    color: #222222;
    font: 10pt &quot;Segoe UI&quot;;
}
QTabWidget::pane {
    border: 0px;
    background: #f2f2f2;
}
QTabBar::tab {
    background: #d0d0d0;
    padding: 8px 22px;
    min-width: 120px;
    border: 0px;
}
QTabBar::tab:selected {
    background: #efefef;
}
QGroupBox {
    background: #d6d6d6;
    border: 0px solid #b8b8b8;
    margin-top: 18px;
    padding: 12px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}
QLabel {
    background: transparent;
}
QLineEdit, QComboBox {
    background: #c7c7c7;
    border: 1px solid #bdbdbd;
    min-height: 24px;
    padding: 2px 6px;
}
QLineEdit:disabled, QComboBox:disabled, QPushButton:disabled {
    color: #999999;
    background: #dcdcdc;
}
QPushButton {
    background: #d4d4d4;
    border: 1px solid #c7c7c7;
    min-height: 30px;
    padding: 4px 16px;
}
QPushButton:hover {
    background: #dddddd;
}
QPushButton#btnCalculate, QPushButton#btnRunOptimization {
    background: #0078d7;
    color: white;
    font-weight: bold;
    border: 0px;
}
QPushButton#btnCalculate:hover, QPushButton#btnRunOptimization:hover {
    background: #0a84e8;
}
QPushButton#btnLoadExperiment {
    background: #76a7d3;
    color: white;
    border: 0px;
    text-align: left;
    padding-left: 12px;
}
QPushButton#btnLoadTraining {
    background: #e8eef8;
    color: #333333;
    border: 0px;
    text-align: left;
    padding-left: 12px;
}
QTableWidget {
    background: #f7f7f7;
    gridline-color: #555555;
    border: 1px solid #444444;
}
QHeaderView::section {
    background: #d9d9d9;
    border: 1px solid #888888;
    padding: 4px;
    font-weight: bold;
}
QLineEdit#searchEdit {
    background: #d9d9d9;
    border: 0px;
}
QLabel#resultValue {
    background: #ffffff;
    color: #0078d7;
    font-size: 36pt;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}
QFrame#messageFrame {
    background: #d6d6d6;
    border: 0px;
}</string>
